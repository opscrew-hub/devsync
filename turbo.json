{
  "tasks": {
    "dev": {
      "cache": false,
      "persistent": true
    },
    "build": {
      "dependsOn": [
        "^build"
      ],
      "outputs": [
        ".next/**",
        "!.next/cache/**"
      ],
      "env": [
        "DATABASE_URL",
        "AUTH_*"
      ]
    },
    "lint": {},
    "typecheck": {},
    "test": { "env": ["DATABASE_URL", "DEVSYNC_TEST_DB"], "cache": false }
  }
}

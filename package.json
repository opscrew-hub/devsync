{
  "name": "devsync",
  "private": true,
  "description": "DevSync: OpsCrew's module for planning a project's work with its people and coding agents.",
  "packageManager": "pnpm@10.29.1",
  "engines": {
    "node": ">=22.9"
  },
  "type": "module",
  "scripts": {
    "typecheck": "turbo run typecheck",
    "test": "turbo run test",
    "lint": "biome check .",
    "format": "biome check --write .",
    "check": "pnpm lint && pnpm typecheck && pnpm test",
    "db:generate": "pnpm --filter @devsync/server exec drizzle-kit generate"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.6.7",
    "@types/node": "^22.20.5",
    "turbo": "^2.11.11",
    "typescript": "^7.0.2",
    "vitest": "^5.1.0"
  }
}

generator client {
  provider = "prisma-client"
  output = "../generated/client"
  moduleFormat = "esm"
  importFileExtension = "ts"
}
datasource db {
  provider = "postgresql"
  url = env("DATABASE_URL")
}
enum Role {
  OWNER
  ADMIN
  DEVELOPER
  VIEWER
}
enum TaskStatus {
  BACKLOG
  READY
  CLAIMED
  IN_PROGRESS
  BLOCKED
  REVIEW
  DONE
  CANCELLED
}
model User {
  id String @id
  name String
  memberships ProjectMember[]
  tasks Task[] @relation("TaskCreator")
  assignedTasks Task[] @relation("TaskAssignee")
  signals Signal[]
  comments TaskComment[]
}
model Project {
  id String @id @default(cuid())
  name String
  description String
  createdAt DateTime @default(now())
  members ProjectMember[]
  tasks Task[]
  agents Agent[]
}
model ProjectMember {
  projectId String
  userId String
  role Role
  project Project @relation(fields: [projectId], references: [id], onDelete: Cascade)
  user User @relation(fields: [userId], references: [id])
  @@id([projectId, userId])
  @@index([userId])
}
model Task {
  id String @id @default(cuid())
  projectId String
  creatorId String
  assigneeId String?
  claimAgentId String?
  claimId String?
  claimExpiresAt DateTime?
  title String
  description String
  acceptanceCriteria String
  status TaskStatus @default(BACKLOG)
  revision Int @default(1)
  version Int @default(1)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  project Project @relation(fields: [projectId], references: [id], onDelete: Cascade)
  creator User @relation("TaskCreator", fields: [creatorId], references: [id])
  assignee User? @relation("TaskAssignee", fields: [assigneeId], references: [id], onDelete: SetNull)
  claimAgent Agent? @relation(fields: [claimAgentId], references: [id], onDelete: NoAction)
  revisions TaskRevision[]
  comments TaskComment[]
  @@index([projectId, status])
  @@index([projectId, assigneeId])
}
model TaskRevision {
  taskId String
  number Int
  title String
  description String
  acceptanceCriteria String
  createdAt DateTime @default(now())
  task Task @relation(fields: [taskId], references: [id], onDelete: Cascade)
  @@id([taskId, number])
}

model TaskComment {
  id String @id @default(cuid())
  taskId String
  authorId String
  body String
  createdAt DateTime @default(now())
  task Task @relation(fields: [taskId], references: [id], onDelete: Cascade)
  author User @relation(fields: [authorId], references: [id])
  @@index([taskId, createdAt])
}

enum AgentType {
  CODEX
  CLAUDE
}

model Agent {
  id String @id @default(cuid())
  projectId String
  name String
  type AgentType
  credentialHash String @unique
  expiresAt DateTime
  revokedAt DateTime?
  lastHeartbeat DateTime?
  createdAt DateTime @default(now())
  project Project @relation(fields: [projectId], references: [id], onDelete: Cascade)
  signals Signal[] @relation("SignalRecipient")
  sentSignals Signal[] @relation("SignalAgentSender")
  claimedTasks Task[]
  @@unique([projectId, id])
}

model Signal {
  id String @id @default(cuid())
  projectId String
  recipientId String
  senderId String?
  senderAgentId String?
  replyToId String? @unique
  hopCount Int @default(0)
  kind String
  payload Json
  idempotencyKey String
  createdAt DateTime @default(now())
  acknowledgedAt DateTime?
  recipient Agent @relation("SignalRecipient", fields: [projectId, recipientId], references: [projectId, id], onDelete: Cascade)
  sender User? @relation(fields: [senderId], references: [id], onDelete: Restrict)
  senderAgent Agent? @relation("SignalAgentSender", fields: [projectId, senderAgentId], references: [projectId, id], onDelete: Cascade)
  replyTo Signal? @relation("SignalReply", fields: [replyToId], references: [id], onDelete: Cascade)
  reply Signal? @relation("SignalReply")
  @@unique([projectId, senderId, idempotencyKey])
  @@unique([projectId, senderAgentId, idempotencyKey])
  @@index([projectId, senderAgentId, createdAt])
  @@index([projectId, recipientId, acknowledgedAt, createdAt])
}

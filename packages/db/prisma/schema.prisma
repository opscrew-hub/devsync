generator client {
  provider = "prisma-client"
  output = "../generated/client"
  moduleFormat = "esm"
  importFileExtension = "ts"
}
datasource db {
  provider = "postgresql"
  url = env("DATABASE_URL")
}
enum Role {
  OWNER
  ADMIN
  DEVELOPER
  VIEWER
}
enum TaskStatus {
  BACKLOG
  READY
  CLAIMED
  IN_PROGRESS
  BLOCKED
  REVIEW
  DONE
  CANCELLED
}
model User {
  id String @id
  name String
  memberships ProjectMember[]
  tasks Task[] @relation("TaskCreator")
  assignedTasks Task[] @relation("TaskAssignee")
  signals Signal[]
  outboxEvents OutboxEvent[]
  auditLogs AuditLog[]
  requestedRuns AgentRun[] @relation("RequestedRuns")
  decidedRuns AgentRun[] @relation("DecidedRuns")
  comments TaskComment[]
}
model Project {
  id String @id @default(cuid())
  name String
  description String
  createdAt DateTime @default(now())
  members ProjectMember[]
  tasks Task[]
  agents Agent[]
  outboxEvents OutboxEvent[]
  auditLogs AuditLog[]
  realtime ProjectRealtime?
  githubRepository GithubRepository?
}
model ProjectMember {
  projectId String
  userId String
  role Role
  project Project @relation(fields: [projectId], references: [id], onDelete: Cascade)
  user User @relation(fields: [userId], references: [id])
  @@id([projectId, userId])
  @@index([userId])
}
model Task {
  id String @id @default(cuid())
  projectId String
  creatorId String?
  creatorAgentId String?
  createRequestId String?
  assigneeId String?
  pullRequestNumber Int?
  claimAgentId String?
  claimId String?
  claimExpiresAt DateTime?
  title String
  description String
  acceptanceCriteria String
  status TaskStatus @default(BACKLOG)
  revision Int @default(1)
  version Int @default(1)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  project Project @relation(fields: [projectId], references: [id], onDelete: Cascade)
  creator User? @relation("TaskCreator", fields: [creatorId], references: [id], onDelete: Restrict)
  creatorAgent Agent? @relation("AgentTaskCreator", fields: [projectId, creatorAgentId], references: [projectId, id], onDelete: Cascade)
  assignee User? @relation("TaskAssignee", fields: [assigneeId], references: [id], onDelete: SetNull)
  claimAgent Agent? @relation(fields: [claimAgentId], references: [id], onDelete: NoAction)
  revisions TaskRevision[]
  comments TaskComment[]
  @@index([projectId, status])
  @@index([projectId, assigneeId])
  outboxEvents OutboxEvent[]
  @@unique([projectId, id])
  runs AgentRun[]
  @@unique([projectId, creatorAgentId, createRequestId])
}
model TaskRevision {
  taskId String
  number Int
  title String
  description String
  acceptanceCriteria String
  createdAt DateTime @default(now())
  task Task @relation(fields: [taskId], references: [id], onDelete: Cascade)
  @@id([taskId, number])
}

model TaskComment {
  id String @id @default(cuid())
  taskId String
  authorId String
  body String
  createdAt DateTime @default(now())
  task Task @relation(fields: [taskId], references: [id], onDelete: Cascade)
  author User @relation(fields: [authorId], references: [id])
  @@index([taskId, createdAt])
}

enum AgentType {
  CODEX
  CLAUDE
}

model Agent {
  id String @id @default(cuid())
  projectId String
  name String
  type AgentType
  credentialHash String @unique
  expiresAt DateTime
  revokedAt DateTime?
  lastHeartbeat DateTime?
  createdAt DateTime @default(now())
  project Project @relation(fields: [projectId], references: [id], onDelete: Cascade)
  signals Signal[] @relation("SignalRecipient")
  sentSignals Signal[] @relation("SignalAgentSender")
  claimedTasks Task[]
  createdTasks Task[] @relation("AgentTaskCreator")
  outboxEvents OutboxEvent[]
  @@unique([projectId, id])
}

model Signal {
  id String @id @default(cuid())
  projectId String
  recipientId String
  senderId String?
  senderAgentId String?
  githubDeliveryId String?
  replyToId String? @unique
  hopCount Int @default(0)
  kind String
  payload Json
  idempotencyKey String
  createdAt DateTime @default(now())
  acknowledgedAt DateTime?
  recipient Agent @relation("SignalRecipient", fields: [projectId, recipientId], references: [projectId, id], onDelete: Cascade)
  sender User? @relation(fields: [senderId], references: [id], onDelete: Restrict)
  senderAgent Agent? @relation("SignalAgentSender", fields: [projectId, senderAgentId], references: [projectId, id], onDelete: Cascade)
  replyTo Signal? @relation("SignalReply", fields: [replyToId], references: [id], onDelete: Cascade)
  reply Signal? @relation("SignalReply")
  githubDelivery GithubEvent? @relation(fields: [githubDeliveryId], references: [deliveryId], onDelete: Cascade)
  @@unique([githubDeliveryId, recipientId])
  @@unique([projectId, senderId, idempotencyKey])
  @@unique([projectId, senderAgentId, idempotencyKey])
  @@index([projectId, senderAgentId, createdAt])
  @@index([projectId, recipientId, acknowledgedAt, createdAt])
}

model OutboxEvent {
  id String @id @default(cuid())
  projectId String
  actorId String?
  actorAgentId String?
  taskId String?
  requestId String?
  reviewRequestId String? @unique
  kind String
  payload Json
  createdAt DateTime @default(now())
  availableAt DateTime @default(now())
  processedAt DateTime?
  attempts Int @default(0)
  project Project @relation(fields: [projectId], references: [id], onDelete: Cascade)
  actor User? @relation(fields: [actorId], references: [id], onDelete: Restrict)
  actorAgent Agent? @relation(fields: [projectId, actorAgentId], references: [projectId, id], onDelete: Cascade)
  task Task? @relation(fields: [projectId, taskId], references: [projectId, id], onDelete: Cascade)
  reviewRequest OutboxEvent? @relation("ReviewDecision", fields: [reviewRequestId], references: [id], onDelete: Cascade)
  reviewDecision OutboxEvent? @relation("ReviewDecision")
  @@unique([projectId, actorAgentId, requestId])
  @@index([projectId, taskId, createdAt])
  @@index([processedAt, availableAt, createdAt])
}

model AuditLog {
  id String @id @default(cuid())
  projectId String
  actorId String
  action String
  targetId String
  details Json
  createdAt DateTime @default(now())
  project Project @relation(fields: [projectId], references: [id], onDelete: Cascade)
  actor User @relation(fields: [actorId], references: [id], onDelete: Restrict)
  @@index([projectId, createdAt, id])
}

model ProjectRealtime {
  projectId String @id
  version BigInt @default(0)
  project Project @relation(fields: [projectId], references: [id], onDelete: Cascade)
}

model GithubEvent {
  deliveryId String @id
  event String
  installationId BigInt
  repositoryId BigInt
  payload Json
  receivedAt DateTime @default(now())
  processedAt DateTime?
  attempts Int @default(0)
  retryAt DateTime?
  lastErrorCode String?
  signals Signal[]
  @@index([processedAt, receivedAt])
  @@index([installationId, repositoryId, receivedAt])
}

model GithubRepository {
  projectId String @id
  installationId BigInt
  repositoryId BigInt
  fullName String
  verifiedAt DateTime @default(now())
  snapshot Json?
  project Project @relation(fields: [projectId], references: [id], onDelete: Cascade)
  @@unique([installationId, repositoryId])
}

enum RunStatus {
  REQUESTED
  QUEUED
  RUNNING
  SUCCEEDED
  FAILED
  REJECTED
  CANCELLED
}

model AgentRun {
  id String @id @default(cuid())
  projectId String
  taskId String
  requestedById String
  decidedById String?
  revision Int
  agentType AgentType
  status RunStatus @default(REQUESTED)
  createdAt DateTime @default(now())
  decidedAt DateTime?
  startedAt DateTime?
  finishedAt DateTime?
  failureReason String?
  changes Json?
  baseCommit String?
  patch String?
  dispatchToken String?
  dispatchExpiresAt DateTime?
  task Task @relation(fields: [projectId, taskId], references: [projectId, id], onDelete: Cascade)
  requestedBy User @relation("RequestedRuns", fields: [requestedById], references: [id], onDelete: NoAction, onUpdate: NoAction)
  decidedBy User? @relation("DecidedRuns", fields: [decidedById], references: [id], onDelete: SetNull, onUpdate: NoAction)
  @@index([projectId, createdAt])
}

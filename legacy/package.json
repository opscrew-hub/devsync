{
  "name": "devsync",
  "private": true,
  "packageManager": "pnpm@11.25.0",
  "scripts": {
    "dev": "turbo dev",
    "build": "turbo build",
    "lint": "turbo lint",
    "typecheck": "turbo typecheck",
    "test": "turbo test",
    "db:generate": "pnpm --filter @devsync/db exec prisma generate",
    "db:migrate": "prisma migrate deploy --schema packages/db/prisma/schema.prisma"
  },
  "devDependencies": {
    "turbo": "^2.5.0",
    "prisma": "6.19.3"
  }
}
